meta {
  name: 03 Get current QR payload
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/qr/current
  body: none
  auth: none
}

tests {
  test("returns only the selected payload", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.deep.equal({
      payload: "sl_qr_unit_A1F9K2"
    });
  });
}
