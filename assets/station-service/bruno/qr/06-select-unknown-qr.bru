meta {
  name: 06 Reject unknown QR code
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/qr/current
  body: json
  auth: none
}

body:json {
  {
    "qrId": "qr-unknown"
  }
}

tests {
  test("returns a not-found error", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("QR_CODE_NOT_FOUND");
  });
}
