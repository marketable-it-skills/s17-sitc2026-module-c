meta {
  name: 01 Get OK charging telemetry
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/batteries/{{batteryOkId}}/last-charging-telemetry
  body: none
  auth: none
}

docs {
  Last completed charging report for a READY pack that stays within safe temperature limits.
}

tests {
  test("returns 200 with raw report shape", function () {
    expect(res.status).to.equal(200);
    expect(res.body.batteryId).to.equal(bru.getEnvVar("batteryOkId"));
    expect(res.body.startTime).to.be.a("string");
    expect(res.body.endTime).to.be.a("string");
    expect(res.body.telemetryData).to.be.an("array");
    expect(res.body.telemetryData.length).to.be.above(100);
  });

  test("samples expose only time, temperature, chargingVoltage", function () {
    const sample = res.body.telemetryData[0];
    expect(Object.keys(sample).sort()).to.deep.equal([
      "chargingVoltage",
      "temperature",
      "time"
    ]);
    expect(sample.time).to.be.a("string");
    expect(sample.temperature).to.be.a("number");
    expect(sample.chargingVoltage).to.be.a("number");
  });

  test("does not include derived or quarantine fields", function () {
    expect(res.body).to.not.have.property("maxTemperature");
    expect(res.body).to.not.have.property("anomalyFlag");
    expect(res.body).to.not.have.property("serviceUnitId");
  });

  test("all sample temperatures stay at or under 55 C", function () {
    const maxTemp = Math.max(
      ...res.body.telemetryData.map((sample) => sample.temperature)
    );
    expect(maxTemp).to.be.at.most(55);
  });
}
