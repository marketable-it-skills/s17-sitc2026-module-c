meta {
  name: 05 Get disabled current QR payload
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/qr/current
  body: none
  auth: none
}

tests {
  test("returns the disabled QR payload for negative-path testing", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.deep.equal({
      payload: "https://app.swaploop.test/stations/station-004"
    });
  });
}
