meta {
  name: 07 Rider cannot list incidents
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/incidents
  body: none
  auth: bearer
}

auth:bearer {
  token: {{riderToken}}
}

tests {
  test("enforces staff role", function () {
    expect(res.status).to.equal(403);
    expect(res.body.code).to.equal("FORBIDDEN");
  });
}
