meta {
  name: 06 Swap reservation status
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/swap-reservations/reservation-001
  body: none
  auth: bearer
}

auth:bearer {
  token: {{riderToken}}
}

tests {
  test("returns active seeded reservation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.state).to.equal("RESERVED");
  });
}
