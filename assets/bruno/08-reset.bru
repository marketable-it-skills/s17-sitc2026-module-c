meta {
  name: 08 Reset canonical state
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/reset
  body: none
  auth: bearer
}

auth:bearer {
  token: {{assessorToken}}
}

tests {
  test("restores frozen clock", function () {
    expect(res.status).to.equal(200);
    expect(res.body.frozenNow).to.equal("2026-08-15T12:00:00+08:00");
  });
}
