meta {
  name: 05 Battery health history
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/batteries/battery-006/health-history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{inspectorToken}}
}

tests {
  test("returns append-only assessments", function () {
    expect(res.status).to.equal(200);
    expect(res.body.assessments).to.be.an("array");
  });
}
